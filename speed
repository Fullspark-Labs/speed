#!/bin/bash

CONFIG_DIR="$HOME/.config/speed"
CONFIG_FILE="$CONFIG_DIR/shortcuts.txt"

mkdir -p "$CONFIG_DIR"

get_command() {
  local name="$1"
  grep "^$name|" "$CONFIG_FILE" 2>/dev/null | cut -d'|' -f2-
}

add_shortcut() {
  local name="$1"
  shift
  local command="$*"

  if [ -z "$name" ] || [ -z "$command" ]; then
    echo "Usage: speed add <name> <command>"
    echo "  Example: speed add ghpush 'git add . && git commit \"\$1\" && git push'"
    exit 1
  fi

  if [ -n "$(get_command "$name")" ]; then
    echo "Shortcut '$name' already exists. Delete it first with: speed delete $name"
    exit 1
  fi

  echo "$name|$command" >> "$CONFIG_FILE"
  echo "Added shortcut: $name"
}

delete_shortcut() {
  local name="$1"

  if [ -z "$name" ]; then
    echo "Usage: speed delete <name>"
    exit 1
  fi

  if [ -z "$(get_command "$name")" ]; then
    echo "Shortcut '$name' not found"
    exit 1
  fi

  sed -i '' "/^$name|/d" "$CONFIG_FILE"
  echo "Deleted shortcut: $name"
}

list_shortcuts() {
  if [ ! -f "$CONFIG_FILE" ] || [ ! -s "$CONFIG_FILE" ]; then
    echo "No shortcuts defined. Add one with: speed add <name> <command>"
    exit 0
  fi

  echo "Shortcuts:"
  while IFS= read -r line; do
    name="${line%%|*}"
    command="${line#*|}"
    echo "  $name: $command"
  done < "$CONFIG_FILE"
}

run_shortcut() {
  local name="$1"
  shift

  local command
  command=$(get_command "$name")

  if [ -z "$command" ]; then
    echo "Shortcut '$name' not found"
    exit 1
  fi

  eval "$command"
}

show_help() {
  echo "Usage: speed <command> [options]"
  echo ""
  echo "Commands:"
  echo "  add <name> <command>  - Add a new shortcut"
  echo "  delete <name>        - Delete a shortcut"
  echo "  list                 - List all shortcuts"
  echo "  run <name> [args]    - Run a shortcut (or just: speed <name> [args])"
  echo ""
  echo "Examples:"
  echo "  speed add ghpush 'git add . && git commit \"\$1\" && git push'"
  echo "  speed ghpush 'my commit message'"
}

case "$1" in
  add)
    shift
    add_shortcut "$@"
    ;;
  delete)
    delete_shortcut "$2"
    ;;
  list)
    list_shortcuts
    ;;
  run)
    shift
    run_shortcut "$@"
    ;;
  -h|--help|help)
    show_help
    ;;
  *)
    if [ -z "$1" ]; then
      show_help
      exit 0
    fi

    run_shortcut "$@"
    ;;
esac